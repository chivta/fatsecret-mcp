{
  "name": "fatsecret-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for FatSecret API with 3-Legged OAuth support",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "fatsecret",
    "nutrition",
    "api",
    "oauth"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^17.0.1",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "typescript": "^5.8.3"
  },
  "bin": {
    "fatsecret-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=24"
  }
}
