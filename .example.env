# FatSecret app Client ID (from https://platform.fatsecret.com/)
CLIENT_ID=
# FatSecret app Client Secret
CLIENT_SECRET=
# FatSecret user OAuth 1.0 access token (obtain with `node dist/cli.js`)
ACCESS_TOKEN=
# FatSecret user OAuth 1.0 access token secret (obtain with `node dist/cli.js`)
ACCESS_TOKEN_SECRET=
# Password for the single-user login form shown when connecting from claude.ai
AUTH_PASSWORD=
# Public base URL of the server, used as OAuth issuer; MCP endpoint is ${PUBLIC_URL}/mcp
PUBLIC_URL=https://fatsecret.example.com
# Directory holding auth.db (SQLite: OAuth clients, codes, tokens); default ./data
DATA_DIR=./data
# HTTP listen port; default 8080
PORT=8080
# Log level: fatal, error, warn, info, debug, trace, silent; default info
LOG_LEVEL=info
